{
  "name": "@with-logic/fast-forward",
  "version": "0.2.0",
  "packageManager": "npm@11.6.2",
  "description": "A TypeScript library that wraps objects in a cache-aware Proxy for faster method calls",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src"
  ],
  "directories": {
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'examples/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' examples/**/*.ts",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "check": "npm run build && npm run test && npm run lint && npm run format:check",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run format && npm run lint",
    "coverage": "jest --coverage",
    "prepare-release": "node scripts/publish.js"
  },
  "keywords": [
    "cache",
    "proxy",
    "memoize",
    "performance",
    "typescript"
  ],
  "author": "LOGIC, Inc.",
  "license": "MIT",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^30.5.2",
    "prettier": "^3.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.2"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "json-stable-stringify": "^1.2.1"
  },
  "overrides": {
    "js-yaml@^3.0.0": "3.15.2",
    "js-yaml@^4.0.0": "4.3.2",
    "picomatch@^2.0.0": "2.3.2",
    "uuid": "11.1.1",
    "minimatch@^3.0.4": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@^5.0.0": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@^9.0.0": {
      "brace-expansion": "2.1.7"
    },
    "argparse@^1.0.0": "2.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/with-logic/fast-forward.git"
  },
  "bugs": {
    "url": "https://github.com/with-logic/fast-forward/issues"
  },
  "homepage": "https://github.com/with-logic/fast-forward#readme"
}
