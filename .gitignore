# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
coverage/

# IDE files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db

# Cache directories
.fastforward-cache/
.my-custom-cache/

# Crew-managed project copies. The names review, review-* and
# pull-request-description are reserved for Crew; authored skills with other
# names stay tracked.
/.*/skills/pull-request-description/
/.*/skills/review/
/.*/skills/review-*/
/.*/skills/.crew-target
/.*/skills/.crew-target.lock.owner
